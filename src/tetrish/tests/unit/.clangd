# clangd config for tetrish unit tests.
#
# clangd resolves relative -I flags from CompileFlags.Add against the directory
# of the file being compiled, not against this file's directory, so these paths
# are written relative to the sources sitting beside this config rather than
# copied from the Makefile's INC. A .clangd at the component root cannot work
# for sources in a subdirectory for exactly that reason.
CompileFlags:
  Add:
    - -I../../includes
    - -I../../libft/includes
    - -I../unity
