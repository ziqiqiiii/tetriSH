# Keep the build context small and the image free of host-built artefacts.
# Anything listed here is either rebuilt inside the container by `make` or bind
# mounted at run time by scripts/container.sh.

# Version control and editor/agent state
.git
.gitattributes
.gitignore
.claude
.scratch

# Docker's own files
Dockerfile
.dockerignore

# The artwork, 183 MB of it, bind mounted read-only at the same path the
# compiled-in ASSET_DIR names. Copying it into a layer would only produce a
# copy the mount immediately shadows, on every rebuild.
src/tetrisu/assets/

# Development credentials. Never bake these into an image — the host mints them
# (`make certs`) and scripts/container.sh mounts them read-only, because the
# client has to verify the server against the same CA the server was signed by.
certs/

# Host build output. Objects built against the host's libraries would shadow
# the container's and break the link, so they must not enter the context.
**/obj/
**/obj-container/
**/*.o
**/*.a
**/*.d
**/*.so
**/*.so.*
**/*.dylib
bin/
src/tetrish/bin/
src/tetrish/macmini_shell
src/tetrisd/tetrisd
src/tetrislogd/tetrislogd
src/tetrisctl/tetrisctl
src/tetrisu/bin/
src/tetrisu/bin-container/

# Daemon runtime state and test scratch — recreated at run time
tmp/
**/tests/tmp/
**/tests/bin/
archive/

# clangd's generated database and cache: absolute paths from the host machine,
# meaningless (and misleading) inside the image
compile_commands.json
.cache/

# Debug droppings
vgcore.*
core
core.*
*.dSYM/
.DS_Store
