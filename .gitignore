# Prerequisites
*.d

# macOS Finder metadata
.DS_Store

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Session credentials. The two public certificates are committed on purpose, so
# a downloaded client can verify the demo server without being handed a file out
# of band; every private key stays local and is minted by `make certs`.
#
# The pattern is `certs/*` and not `certs/`: git does not descend into an
# excluded directory, so a `!certs/ca.crt` under `certs/` would never be
# reached and the negation would silently do nothing.
certs/*
!certs/ca.crt
!certs/server.crt

# Build output directories
bin/
tests/bin/
tests/tmp/
**/tests/tmp/

